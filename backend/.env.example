# Copy to backend/.env and edit. Every value is optional.

# Server
SCRIBE_HOST=127.0.0.1
SCRIBE_PORT=5000

# SQLite database file (created automatically)
SCRIBE_DATABASE_PATH=instance/scribe.db

# Upload limits
SCRIBE_MAX_UPLOAD_MB=2
SCRIBE_MIN_TRANSCRIPT_WORDS=20

# Models (the notebook's choices; change only if you know why)
SCRIBE_SUMMARIZER_MODEL=sshleifer/distilbart-cnn-12-6
SCRIBE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SCRIBE_SPACY_MODEL=en_core_web_sm
# auto | cpu | cuda
SCRIBE_DEVICE=auto
# Load all models when the server starts instead of on first use
SCRIBE_PRELOAD_MODELS=false

# Semantic search hides results below this cosine similarity
SCRIBE_SEMANTIC_MIN_SCORE=0.25

# Comma-separated origins allowed to call the API (the Vite dev server)
SCRIBE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Run analysis in a background thread (keep true when running the server)
SCRIBE_ASYNC_ANALYSIS=true
